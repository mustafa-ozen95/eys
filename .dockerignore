# Derleme bağlamına GİRMEYECEKLER.
#
# Buradaki her satır imaj boyutunu değil, YENİDEN DERLEME sıklığını da
# belirler: bağlamdaki bir dosya değişince katman önbelleği düşer.

.git
# Çalışan sürüm için yalnız HEAD ve ref'ler (docker/surum-oku.sh); nesneler girmez.
!.git/HEAD
!.git/packed-refs
!.git/refs/heads/
.github
node_modules
vendor
public/build
public/hot
storage/app/*
!storage/app/.gitignore
!storage/app/public
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*
tests/Browser/results
tests/Browser/shots
tests/Browser/snapshots

# Gizli değerler imaja ASLA girmez; çalışma anında env ile verilir.
#
# KURULUM YAPILANDIRMASI DA (.env ve kökteki *.conf) burada olmak
# zorunda: compose onu depo kökünde okuyor ve Dockerfile "COPY . ." yapıyor;
# buradan düşerse içindeki anahtarlar imaja girer. İmajlar ghcr.io'ya
# gidiyor: oraya giren bir sır herkese açıktır.
.env
.env.*
!.env.example
/*.conf

*.log
*.sqlite
.phpunit.result.cache
.DS_Store

# EYS'ye özel
/tests/Browser/test-results
/playwright-report
