# ============================================================================
#  eys (Erişim Yönetim Sistemi) — kurulum değişkenleri
# ============================================================================
#  docker compose ile:   cp .env.example .env   (izin 600; git'e ve imaja girmez)
#  Bir platformda (NineDeploy, Coolify, Dokploy...): bu adları platformun
#  değişken ekranına girin, sırları "gizli" işaretleyin.
#
#  Boş bırakılan satır konteynere BOŞ değer olarak geçer; varsayılanı
#  kullanmak için satırı silin ya da başına # koyun.
# ============================================================================

# ----------------------------------------------------------------------------
#  Uygulama
# ----------------------------------------------------------------------------
#  ⚠ APP_KEY'İ YEDEKLEYİN: KASADAKİ BÜTÜN PAROLALAR bu anahtarla şifrelenir.
#  Anahtar kaybolursa veritabanı duruyor olsa bile hiçbiri okunamaz. Boşsa ilk
#  açılışta üretilir ve YALNIZCA storage/app/app-key.txt içinde saklanır
#  (günlüğe basılmaz); oradan alıp buraya yazın.
APP_KEY=
APP_URL=https://eys.ornek.test
# APP_NAME="EYS"
# APP_TIMEZONE=Europe/Istanbul

# ----------------------------------------------------------------------------
#  Veritabanı
# ----------------------------------------------------------------------------
#  Varsayılan: compose'taki db servisi (MariaDB 11.4). Parolayı siz verin;
#  ilk açılışta kullanıcı ve veritabanı bununla kurulur.
DB_PASSWORD=
# DB_DATABASE=eys
# DB_USERNAME=eys
#
#  Dışarıdaki ya da platformun yönettiği bir MariaDB/MySQL için adresini
#  verin ve db servisini kapatın:
# DB_HOST=
# DB_PORT=3306
# VT_KOPYA=0

# ----------------------------------------------------------------------------
#  İlk yönetici — YALNIZCA ilk açılışta, kullanıcı tablosu boşken
# ----------------------------------------------------------------------------
#  ADMIN_EMAIL BOŞSA HESAP HİÇ AÇILMAZ (varsayılan bir adres, imajı indiren
#  herkeste aynı giriş demekti). Sonradan açmak için (parola sorulur):
#      docker compose exec panel php artisan erisim:yonetici-ekle
#  ADMIN_PASSWORD boşsa RASTGELE üretilir ve YALNIZCA storage/app/ilk-parola.txt
#  içine yazılır (günlüğe basılmaz); giriş yapıp değiştirdikten sonra silin.
ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME="Sistem Yöneticisi"
#  Örnek veri: admin dışındaki yerleşik roller (network, teknik); yalnız ilk açılışta.
# ORNEK_VERI=false

# ----------------------------------------------------------------------------
#  Güvenlik
# ----------------------------------------------------------------------------
#  Dakikada izin verilen giriş denemesi; 0 = SINIR YOK. Kasa için bir sınır
#  önerilir (örn. 10).
# LOGIN_THROTTLE=10
#  Denetim zincirinin anahtarı. APP_KEY'DEN AYRI TUTUN: APP_KEY döndürüldüğü
#  gün bütün geçmiş "kırık" görünmesin. Üretmek için: openssl rand -hex 32
ACTIVITY_CHAIN_KEY=
#  Parola döndürme işleri. Deneme ya da taşıma kurulumunda false: canlı
#  cihazların parolası iki yerden döndürülmesin.
# ROTATION_ENABLED=true

# ----------------------------------------------------------------------------
#  Uzak oturumlar (tarayıcıdan SSH / RDP)
# ----------------------------------------------------------------------------
#  SSH (ttyd) her zaman çalışır. RDP için Guacamole gerekir ve YALNIZCA bu sır
#  verilmişse başlatılır (verilmezse 200 MB'lık JVM hiç açılmaz). 16 BAYTLIK
#  onaltılık dize (32 karakter): head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
# GUACAMOLE_SECRET=
# GUACAMOLE_USER=guacadmin

# ----------------------------------------------------------------------------
#  Cihaz arayüzleri (ESXi, VAMI) — vekillenen arayüzün kökeni
# ----------------------------------------------------------------------------
#  Arayüz panelle AYNI adın AYRI portunda verilir (ortak köken 9443, oturum
#  başına 9450-9479): cihazın arayüzünden çıkan bir betik panele, oturumu açan
#  kişi adına istek atamasın. Boşsa arayüz panelin kendi kökeninden verilir.
#  Bu portları compose'taki arayuz-vekili karşılar: ARAYUZ_VEKILI_KOPYA=1 ve
#  arayuz-sertifika hacmine panelin sertifikası (tls.crt, tls.key).
# ARAYUZ_ALANI=eys.ornek.test:9443
# ARAYUZ_VEKILI_KOPYA=1
# ARAYUZ_TURLERI=esxi,vami

# ----------------------------------------------------------------------------
#  Kimlik Yönetim Merkezi ile giriş (SSO)
# ----------------------------------------------------------------------------
#  KIMLIK_ACIK=true ise panel kendi giriş formu yerine merkeze yönlendirir.
#  İstemci kimliği ve sırrı merkezdeki "İstemciler" ekranından; dönüş adresi
#  oradaki kayıtla BİREBİR aynı olmalı. Bildirim sırrı boşsa erişim kaldırma
#  beş dakikalık eşitleme turunu bekler. Merkezin sertifikası genel bir
#  otoriteden değilse kök sertifikası KIMLIK_KOK'a (PEM).
# KIMLIK_ACIK=false
# KIMLIK_ADRES=https://kimlik.ornek.test
# KIMLIK_ISTEMCI=
# KIMLIK_ISTEMCI_SIR=
# KIMLIK_DONUS=https://eys.ornek.test/giris/merkez/geri
# KIMLIK_BILDIRIM_SIR=
# KIMLIK_AD="Kimlik Yönetim Merkezi"
# KIMLIK_KOK=

# ----------------------------------------------------------------------------
#  Görünüm
# ----------------------------------------------------------------------------
#  Merkez ve paneller aynı üst alan adındaysa gece/gündüz seçimi paylaşılır;
#  ayrı alan adlarındaysa boş bırakın.
# TEMA_ALANI=.ornek.test

# ----------------------------------------------------------------------------
#  Güncelleme kontrolü (Ayarlar → Güncelleme)
# ----------------------------------------------------------------------------
#  Panel her sabah son başarılı imaj derlemesine bakar; YALNIZCA bakar.
#  Fine-grained jeton: yalnız panel depoları, Contents ve Actions: read.
# GUNCELLEME_JETONU=

# ----------------------------------------------------------------------------
#  E-posta — "log" seçilirse mailler GÖNDERİLMEZ, yalnızca günlüğe yazılır
# ----------------------------------------------------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=erisim@ornek.test
# MAIL_FROM_NAME="Erişim Yönetim Sistemi"

# ----------------------------------------------------------------------------
#  Kurulum
# ----------------------------------------------------------------------------
#  Konteyner ve hacim adlarının öneki; aynı sunucuda ikinci kurulumda değişir.
# ONEK=eys
#  Deneme ya da taşıma kurulumu: konteynerler cihazlara ve dışarıya bağlanamaz.
# AG_YALITIMI=true
