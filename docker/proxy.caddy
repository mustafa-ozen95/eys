# Erişim Yönetim Sistemi — kendi Caddy'niz için örnek kural
#
# Platformun vekili (NineDeploy/Traefik, Coolify...) kullanılıyorsa GEREKMEZ.
# Caddy panelle aynı Docker ağında durur ve panele konteyner adıyla ulaşır
# (varsayılan eys; STACK_PREFIX değiştiyse o). Alan adını değiştirip Caddyfile'a
# ekleyin ya da import edin. Cihaz arayüzü portları (9443, 9450-9479) için
# compose'taki interface-proxy servisine bakın (docker/README.md).

eys.ornek.test {
	reverse_proxy eys:80 {
		# Panel bu başlıklara bakarak isteğin HTTPS olduğunu anlar. Caddy
		# X-Forwarded-Proto'yu kendiliğinden ekler; Host'u da geçirmek
		# gerekiyor, çünkü panel mutlak adresleri ondan üretiyor.
		header_up Host {host}
		header_up X-Real-IP {remote_host}

		# Tarayıcıdan SSH/RDP oturumları WebSocket'tir ve SAATLERCE açık
		# kalabilir. Varsayılan okuma süresi dolunca oturum sessizce düşerdi.
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}
