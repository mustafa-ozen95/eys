#!/usr/bin/env bash
#
# Vekillenen cihazların nginx bağlantı havuzlarını güncel tutar.
#
# NEDEN VAR: vekil hedefi bir DEĞİŞKENDEN okuyor ve nginx böyle bir hedefe
# bağlantı havuzu tutmuyor — her isteğe yeni TLS el sıkışması. Zayıf işlemcili
# bir BMC'de bu tek başına yarım saniye; arayüzün onlarca varlığı yüklenene
# kadar sayfa boş kalır. Gerekçe: ArayuzHavuzlariCommand.
#
# İKİ KİP:
#   yaz  — bir kez üretir (açılışta, nginx başlamadan önce çağrılır)
#   izle — belli aralıkla üretir, DEĞİŞTİYSE nginx'i yeniler
#
# Listenin tek kaynağı kasadır. "izle" olmasaydı sonradan eklenen bir cihaz
# bir sonraki açılışa kadar havuzsuz, yani sessizce yavaş kalırdı.
set -uo pipefail

PHP=/usr/bin/php
UYGULAMA=/uygulama
HEDEF=/etc/nginx/conf.d/arayuz-havuzlari.conf
ARALIK="${ARAYUZ_HAVUZ_ARALIGI:-300}"

# Yapılandırmayı üretir ve değiştiyse yerine koyar.
#
# Dosya ANCAK ÜRETİM BAŞARILIYSA değiştirilir: veritabanına ulaşılamadığında
# eldeki listeyi silmek, çalışan havuzları da yok etmek olurdu. Üretim `eys`
# kullanıcısıyla yapılır — artisan'ın kayıt dosyalarını root'a geçirmemek için.
#
# Dönüş: 0 değişti, 10 zaten güncel, 1 üretilemedi.
uret() {
    local gecici
    gecici="$(mktemp)"

    if ! (cd "${UYGULAMA}" && gosu eys "${PHP}" artisan erisim:arayuz-havuzlari) > "${gecici}" 2>/dev/null \
        || ! grep -q '^map \$arayuz_hedef' "${gecici}"; then
        rm -f "${gecici}"

        return 1
    fi

    if cmp -s "${gecici}" "${HEDEF}"; then
        rm -f "${gecici}"

        return 10
    fi

    # Yenisi sınanmadan eskisi atılmaz: izle kipi nginx -t başarısız olursa
    # bu kopyayı geri koyar (bozuk bir dosya bir sonraki açılışı da düşürür).
    cp -f "${HEDEF}" "${HEDEF}.onceki" 2>/dev/null || true
    cat "${gecici}" > "${HEDEF}"
    rm -f "${gecici}"

    return 0
}

case "${1:-yaz}" in
    yaz)
        uret
        [[ $? -eq 1 ]] && exit 1
        exit 0
        ;;
    izle)
        while :; do
            sleep "${ARALIK}"

            uret
            durum=$?

            # Yalnızca DEĞİŞİKLİKTE yenilenir. nginx -t önce çalışır: bozuk bir
            # dosyayla yenilemek, ayakta duran vekili de düşürürdü.
            if [[ ${durum} -eq 0 ]]; then
                if nginx -t >/dev/null 2>&1; then
                    nginx -s reload >/dev/null 2>&1 \
                        && printf '\033[1;34m[eys]\033[0m Cihaz bağlantı havuzları yenilendi.\n'
                elif [[ -f "${HEDEF}.onceki" ]]; then
                    # Üretilen dosya nginx'e geçmedi: ESKİSİ GERİ KONUR. Yoksa
                    # bozuk dosya diskte kalır ve nginx bir sonraki açılışta
                    # hiç kalkmazdı.
                    cat "${HEDEF}.onceki" > "${HEDEF}"
                    printf '\033[1;31m[eys]\033[0m Havuz yapılandırması nginx -t sınamasını geçemedi; eskisi geri konuldu.\n' >&2
                fi
            fi
        done
        ;;
    *)
        printf 'Kullanım: %s [yaz|izle]\n' "$0" >&2
        exit 64
        ;;
esac
