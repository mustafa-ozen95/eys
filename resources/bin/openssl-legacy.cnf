# NTLM'in MD4'e ihtiyacı var; OpenSSL 3 onu varsayılan sağlayıcıdan çıkardı.
#
# Sistem genelindeki openssl.cnf'e DOKUNULMAZ: bu dosya yalnızca WinRM
# yardımcısı çağrılırken OPENSSL_CONF ile verilir, etkisi o sürece kalır.
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
legacy = legacy_sect

[default_sect]
activate = 1

[legacy_sect]
activate = 1
